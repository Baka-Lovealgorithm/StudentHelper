{
  "name": "studenthelper-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:math": "node --experimental-strip-types scripts/check-math-text.mjs",
    "check:stream": "node --experimental-strip-types scripts/check-stream-events.mjs",
    "check:sections": "node --experimental-strip-types scripts/check-sections.mjs",
    "check:views": "node --experimental-strip-types scripts/check-views.mjs",
    "check": "npm run check:math && npm run check:stream && npm run check:sections && npm run check:views"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
